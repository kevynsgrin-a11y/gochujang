{
  "name": "gochujang",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Gochujang - a controlled, no-collection culinary preview",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs && node scripts/verify-build.mjs && node scripts/p1p2-verify-platform.mjs && node security/validate-headers.mjs --require-app-ready",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "prerender": "node scripts/prerender.mjs",
    "verify": "node scripts/verify-build.mjs",
    "verify:platform": "node scripts/p1p2-verify-platform.mjs",
    "verify:headers": "node security/validate-headers.mjs --require-app-ready"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "framer-motion": "^11.11.9",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
